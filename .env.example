# ==============================================================================
# ATLAS RESEARCH AGENT — Environment Configuration
# Copy this file to ".env" and fill in your FREE API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) LLM PROVIDER  (pick ONE as primary — all have free tiers)
# ------------------------------------------------------------------------------
# Groq — FREE & very fast. Recommended primary.
#   Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — FREE alternative with generous limits.
#   Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — OPTIONAL (paid). Only if you specifically want GPT models.
OPENAI_API_KEY=

# Which provider to use:  groq | gemini | openai
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# 2) WEB SEARCH
# ------------------------------------------------------------------------------
# Brave Search — FREE 2,000 queries/month. Best quality.
#   Get a key: https://brave.com/search/api/
#   Leave BLANK to automatically fall back to DuckDuckGo (free, no key needed).
BRAVE_API_KEY=

# ------------------------------------------------------------------------------
# 3) CONTENT EXTRACTION
# ------------------------------------------------------------------------------
# Jina Reader — FREE. Works WITHOUT a key. Optional key raises rate limits.
#   Get a key: https://jina.ai/reader/
JINA_API_KEY=

# ------------------------------------------------------------------------------
# 4) OPTIONAL: PUBLIC DEMO PROTECTION
# ------------------------------------------------------------------------------
# If set, the app shows a password gate before anyone can run research. Use this
# on a PUBLIC deployment to stop strangers from draining your free API quota.
# Leave BLANK for an open demo (recommended so recruiters can try it freely).
APP_PASSWORD=
