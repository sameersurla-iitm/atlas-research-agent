# ==============================================================================
# Streamlit Cloud Secrets — TEMPLATE
# ==============================================================================
# Do NOT commit a real secrets.toml (it is git-ignored).
#
# For the DEPLOYED app: copy the lines below into
#   Streamlit Cloud → your app → ⋮ → Settings → Secrets
# and replace the placeholder with your current key (no extra quotes/spaces).
#
# For LOCAL dev you don't need this file — use a .env instead (see .env.example).
# ==============================================================================

# Required: one LLM key. Gemini is reachable on most networks.
GEMINI_API_KEY = "your_current_gemini_key"

# Which provider to use: gemini | groq | openai
LLM_PROVIDER = "gemini"

# Optional extras (leave out if unused):
# GROQ_API_KEY = "your_groq_key"
# BRAVE_API_KEY = "your_brave_key"        # else falls back to DuckDuckGo (free)
# JINA_API_KEY = "your_jina_key"          # Jina works without a key too
# APP_PASSWORD = "pick-a-password"        # gate the public demo to protect quota
